MONGOUSER=
MONGOPASSWORD=
MONGOHOSTNAME=
DB_NAME=
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173
RP_ID=localhost
ORIGIN=http://localhost:5173

# Attestation conveyance for registration.
# 'direct' (default) lets the server name a passkey after its authenticator.
# 'none' makes the browser zero the AAGUID, so only generic names are possible.
ATTESTATION=direct

# Reauthentication, the treatment under study.
# REAUTH_REQUIRED=false runs the control condition with no reauthentication.
REAUTH_REQUIRED=true
# Subset of operations to gate. Unset means all of them. Names:
# add-passkey, delete-passkey, rename-passkey, delete-account, change-password
# REAUTH_OPERATIONS=add-passkey,delete-passkey
# How long a successful reauthentication stays valid, in milliseconds.
REAUTH_WINDOW_MS=300000
